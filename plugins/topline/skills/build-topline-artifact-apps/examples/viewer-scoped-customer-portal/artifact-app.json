{
  "manifestVersion": 2,
  "id": "viewer-scoped-customer-portal",
  "title": "Viewer-scoped customer portal",
  "kind": "dashboard",
  "runtime": {
    "target": "aws_lambda_function_url",
    "region": "us-west-2",
    "entryPoint": "artifactApp",
    "language": "node"
  },
  "build": {
    "command": "node src/index.js --build",
    "outputDir": "dist"
  },
  "validation": {
    "localCommand": "node src/index.js --test",
    "testCommand": "node src/index.js --test --artifact-tests-json"
  },
  "routes": [
    { "path": "/", "kind": "page", "handler": "artifactApp" },
    { "path": "/_artifact/data/customers", "kind": "api", "handler": "artifactApp" }
  ],
  "sourceBindings": [
    {
      "name": "customers",
      "sourceId": "example-source-id",
      "resource": "customers",
      "mode": "live",
      "access": "viewer",
      "maxRows": 100,
      "maxBytes": 250000,
      "timeoutMs": 5000,
      "viewerRateLimitPerMinute": 30,
      "viewerPolicy": { "requiresSession": true, "emailField": "email" }
    }
  ],
  "env": ["ARTIFACT_ID", "ARTIFACT_VERSION_ID", "ARTIFACT_MANIFEST_URI", "PLATFORM_ARTIFACT_ID", "PLATFORM_ARTIFACT_VERSION_ID", "PLATFORM_ARTIFACT_MANIFEST_URI"],
  "viewerPolicy": "tenant"
}
